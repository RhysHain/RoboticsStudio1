<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="new_world">
    <!-- Basic world setup  -->
    <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
    <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />
    <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system' />

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <intensity>5</intensity>
    </light>

    <!-- Physics & environment -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <!-- Georeference -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    

    <!-- Large ground plane with forest floor texture -->
    <include>
      <uri>model://forest_plane</uri>
      <name>forest_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Forest walls -->
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall1</name>
      <pose>12.5 0 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall2</name>
      <pose>12.5 -9.32 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall3</name>
      <pose>12.5 +9.32 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall4</name>
      <pose>-12.5 0 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall5</name>
      <pose>-12.5 -9.32 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall6</name>
      <pose>-12.5 +9.32 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall7</name>
      <pose>0 12.5 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall8</name>
      <pose>-9.32 12.5 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>model://forest_wall</uri>
      <name>forest_wall9</name>
      <pose>+9.32 12.5 2 1.570796 0 0</pose>
    </include>

    <!-- Oak trees in a 5x5 grid with 5m spacing -->
    <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-10_y-10</name>
        <pose>-10 -10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-5_y-10</name>
        <pose>-5 -10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x0_y-10</name>
        <pose>0 -10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x5_y-10</name>
        <pose>5 -10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x10_y-10</name>
        <pose>10 -10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-10_y-5</name>
        <pose>-10 -5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-5_y-5</name>
        <pose>-5 -5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x0_y-5</name>
        <pose>0 -5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x5_y-5</name>
        <pose>5 -5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x10_y-5</name>
        <pose>10 -5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-10_y0</name>
        <pose>-10 0 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-5_y0</name>
        <pose>-5 0 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x0_y0</name>
        <pose>0 0 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x5_y0</name>
        <pose>5 0 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x10_y0</name>
        <pose>10 0 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-10_y5</name>
        <pose>-10 5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-5_y5</name>
        <pose>-5 5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x0_y5</name>
        <pose>0 5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x5_y5</name>
        <pose>5 5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x10_y5</name>
        <pose>10 5 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-10_y10</name>
        <pose>-10 10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x-5_y10</name>
        <pose>-5 10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x0_y10</name>
        <pose>0 10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x5_y10</name>
        <pose>5 10 -0.3 0 0 0</pose>
      </include>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/oak%20tree</uri>
        <name>oak_x10_y10</name>
        <pose>10 10 -0.3 0 0 0</pose>
      </include>

    <!-- South wall - inline models with box collision AND visual -->
    <model name="south_wall_1">
      <static>true</static>
      <pose>0 -12.5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.32 1.0 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.32 0.1 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://forest_wall/materials/textures/forest_wall_transparent.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall_2">
      <static>true</static>
      <pose>-9.32 -12.5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.32 1.0 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.32 0.1 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://forest_wall/materials/textures/forest_wall_transparent.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall_3">
      <static>true</static>
      <pose>9.32 -12.5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.32 1.0 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.32 0.1 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://forest_wall/materials/textures/forest_wall_transparent.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

